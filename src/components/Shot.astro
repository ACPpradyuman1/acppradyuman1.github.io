---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
type Props = { src: ImageMetadata; alt: string; caption?: string; eager?: boolean }
const { src, alt, caption, eager = false } = Astro.props
---

<figure class="shot">
  <Image src={src} alt={alt} widths={[800, 1400, 2000]} sizes="(width >= 64rem) 42rem, 100vw" loading={eager ? "eager" : "lazy"} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin-block: var(--space-m);
  }
  .shot :global(img) {
    inline-size: 100%;
    block-size: auto;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }
  figcaption {
    margin-block-start: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }
</style>
