---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

type Item = { logo: ImageMetadata; scale?: number; shift?: number; org: string; role: string; detail?: string }
const { items } = Astro.props as { items: Item[] }
---

<ol class="path">
  {items.map((p) => (
    <li>
      <span class="chip">
        <Image
          src={p.logo}
          alt={p.org}
          height={96}
          loading="eager"
          style={[p.scale && `inline-size:${p.scale}%;block-size:${p.scale}%`, p.shift && `transform:translateY(${p.shift}px)`].filter(Boolean).join(";") || undefined}
        />
      </span>
      <span class="text">
        <span class="role">{p.role}</span>
        <span class="org">{p.org}{p.detail && ` · ${p.detail}`}</span>
      </span>
    </li>
  ))}
</ol>

<style>
  .path {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  li {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }
  .chip {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: 9.5rem;
    block-size: 3.25rem;
    padding: 0.45rem 0.6rem;
    background: light-dark(#fff, #e4dfd5);
    border: 1px solid var(--border);
    border-radius: 0.375rem;
  }
  .chip img {
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 0;
    object-fit: contain;
  }
  .text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .role {
    font-size: var(--step-0);
    color: var(--foreground);
  }
  .org {
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }
</style>
