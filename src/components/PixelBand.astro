---
interface Props {
  variant: "skyline" | "treeline";
  height?: number;
}

const { variant, height = variant === "skyline" ? 150 : 96 } = Astro.props;
---

<div class="artwork-band">
  <div class="frame">
    {
      variant === "skyline" ? (
        <svg
          viewBox="0 0 88 14"
          preserveAspectRatio="xMidYMax slice"
          shape-rendering="crispEdges"
          style={{ height: `${height}px` }}
        >
          <rect x="0" y="0" width="88" height="14" fill="#f7f4ed" />

          <!-- moon -->
          <rect x="8" y="1" width="3" height="3" fill="#e8c97a" />

          <!-- stars -->
          <rect x="20" y="2" width="1" height="1" fill="#cfc8b8" />
          <rect x="34" y="4" width="1" height="1" fill="#cfc8b8" />
          <rect x="49" y="1" width="1" height="1" fill="#cfc8b8" />
          <rect x="60" y="3" width="1" height="1" fill="#cfc8b8" />
          <rect x="76" y="2" width="1" height="1" fill="#cfc8b8" />
          <rect x="82" y="5" width="1" height="1" fill="#cfc8b8" />

          <!-- pale hills -->
          <rect x="0" y="10" width="20" height="3" fill="#dfe7e0" />
          <rect x="16" y="9" width="20" height="4" fill="#dfe7e0" />
          <rect x="34" y="11" width="20" height="2" fill="#dfe7e0" />
          <rect x="50" y="9" width="18" height="4" fill="#dfe7e0" />
          <rect x="64" y="10" width="24" height="3" fill="#dfe7e0" />

          <!-- buildings (ink) -->
          <rect x="2" y="6" width="6" height="7" fill="#1a1917" />
          <rect x="3" y="5" width="4" height="1" fill="#1a1917" />
          <rect x="14" y="4" width="7" height="9" fill="#1a1917" />
          <rect x="15" y="3" width="5" height="1" fill="#1a1917" />
          <rect x="30" y="7" width="6" height="6" fill="#1a1917" />
          <rect x="31" y="6" width="4" height="1" fill="#1a1917" />
          <rect x="58" y="6" width="7" height="7" fill="#1a1917" />
          <rect x="59" y="5" width="5" height="1" fill="#1a1917" />
          <rect x="72" y="8" width="6" height="5" fill="#1a1917" />

          <!-- buildings (accent) -->
          <rect x="10" y="8" width="5" height="5" fill="#4c6b5a" />
          <rect x="23" y="5" width="6" height="8" fill="#4c6b5a" />
          <rect x="24" y="4" width="4" height="1" fill="#4c6b5a" />
          <rect x="38" y="4" width="7" height="9" fill="#4c6b5a" />
          <rect x="39" y="3" width="5" height="1" fill="#4c6b5a" />
          <rect x="48" y="8" width="5" height="5" fill="#4c6b5a" />
          <rect x="66" y="5" width="6" height="8" fill="#4c6b5a" />
          <rect x="67" y="4" width="4" height="1" fill="#4c6b5a" />
          <rect x="79" y="7" width="6" height="6" fill="#4c6b5a" />

          <!-- lit windows -->
          <rect x="3" y="8" width="1" height="1" fill="#e8c97a" />
          <rect x="6" y="8" width="1" height="1" fill="#e8c97a" />
          <rect x="3" y="10" width="1" height="1" fill="#e8c97a" />
          <rect x="16" y="6" width="1" height="1" fill="#e8c97a" />
          <rect x="19" y="6" width="1" height="1" fill="#e8c97a" />
          <rect x="16" y="9" width="1" height="1" fill="#e8c97a" />
          <rect x="19" y="9" width="1" height="1" fill="#e8c97a" />
          <rect x="11" y="10" width="1" height="1" fill="#e8c97a" />
          <rect x="25" y="7" width="1" height="1" fill="#e8c97a" />
          <rect x="27" y="9" width="1" height="1" fill="#e8c97a" />
          <rect x="40" y="6" width="1" height="1" fill="#e8c97a" />
          <rect x="42" y="9" width="1" height="1" fill="#e8c97a" />
          <rect x="49" y="10" width="1" height="1" fill="#e8c97a" />
          <rect x="60" y="8" width="1" height="1" fill="#e8c97a" />
          <rect x="62" y="10" width="1" height="1" fill="#e8c97a" />
          <rect x="67" y="7" width="1" height="1" fill="#e8c97a" />
          <rect x="69" y="9" width="1" height="1" fill="#e8c97a" />
          <rect x="74" y="10" width="1" height="1" fill="#e8c97a" />
          <rect x="80" y="9" width="1" height="1" fill="#e8c97a" />

          <rect x="0" y="13" width="88" height="1" fill="#1a1917" />
        </svg>
      ) : (
        <svg
          viewBox="0 0 88 14"
          preserveAspectRatio="xMidYMax slice"
          shape-rendering="crispEdges"
          style={{ height: `${height}px` }}
        >
          <rect x="0" y="0" width="88" height="14" fill="#f7f4ed" />
          <rect x="14" y="3" width="1" height="1" fill="#cfc8b8" />
          <rect x="41" y="2" width="1" height="1" fill="#cfc8b8" />
          <rect x="69" y="3" width="1" height="1" fill="#cfc8b8" />
          <rect x="0" y="10" width="20" height="3" fill="#dfe7e0" />
          <rect x="16" y="9" width="20" height="4" fill="#dfe7e0" />
          <rect x="34" y="11" width="20" height="2" fill="#dfe7e0" />
          <rect x="50" y="9" width="18" height="4" fill="#dfe7e0" />
          <rect x="64" y="10" width="24" height="3" fill="#dfe7e0" />
          <rect x="4" y="6" width="6" height="4" fill="#4c6b5a" />
          <rect x="5" y="5" width="4" height="1" fill="#4c6b5a" />
          <rect x="6" y="10" width="2" height="3" fill="#1a1917" />
          <rect x="16" y="4" width="7" height="5" fill="#1a1917" />
          <rect x="17" y="3" width="5" height="1" fill="#1a1917" />
          <rect x="19" y="9" width="2" height="4" fill="#1a1917" />
          <rect x="30" y="7" width="6" height="4" fill="#4c6b5a" />
          <rect x="31" y="6" width="4" height="1" fill="#4c6b5a" />
          <rect x="32" y="11" width="2" height="2" fill="#1a1917" />
          <rect x="45" y="5" width="7" height="5" fill="#4c6b5a" />
          <rect x="46" y="4" width="5" height="1" fill="#4c6b5a" />
          <rect x="48" y="10" width="2" height="3" fill="#1a1917" />
          <rect x="59" y="7" width="6" height="4" fill="#1a1917" />
          <rect x="60" y="6" width="4" height="1" fill="#1a1917" />
          <rect x="61" y="11" width="2" height="2" fill="#1a1917" />
          <rect x="74" y="5" width="7" height="5" fill="#4c6b5a" />
          <rect x="75" y="4" width="5" height="1" fill="#4c6b5a" />
          <rect x="77" y="10" width="2" height="3" fill="#1a1917" />
          <rect x="0" y="13" width="88" height="1" fill="#1a1917" />
        </svg>
      )
    }
  </div>
</div>
