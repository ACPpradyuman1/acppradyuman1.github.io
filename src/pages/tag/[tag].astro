---
import Base from "../../layouts/Base.astro";
import WritingIndex from "../../components/WritingIndex.astro";
import { getSortedPosts, tagsForFilter } from "../../lib/posts";
import { filters } from "../../site.config";

export async function getStaticPaths() {
  return filters
    .filter((f) => f.value !== "all")
    .map((f) => ({ params: { tag: f.value } }));
}

const { tag } = Astro.params;
const allPosts = await getSortedPosts();
const posts = tagsForFilter(tag!, allPosts);
---

<Base title={`prateek — writing — ${tag}`}>
  <WritingIndex posts={posts} activeFilter={tag!} />
</Base>
