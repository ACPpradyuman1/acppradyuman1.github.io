---
import MetaPage from "@/components/MetaPage.astro"
import Path from "@/components/Path.astro"
import Layout from "@/layouts/Layout.astro"
import { Image } from "astro:assets"
import photo from "@/assets/photos/about.jpg"
import accenture from "@/assets/logos/accenture.svg"
import bain from "@/assets/logos/bain.svg"
import iith from "@/assets/logos/iith.png"
import isb from "@/assets/logos/isb.png"
import qualcomm from "@/assets/logos/qualcomm.svg"

const experience = [
  { logo: bain, org: "Bain & Company", role: "Strategy Consulting" },
  { logo: accenture, scale: 72, shift: -3, org: "Accenture Strategy", role: "Management Consulting" },
  { logo: qualcomm, scale: 68, org: "Qualcomm", role: "Engineering" },
]
const education = [
  { logo: isb, scale: 88, org: "Indian School of Business", role: "Master of Business Administration (MBA)", detail: "Finance, IT & Strategy" },
  { logo: iith, org: "Indian Institute of Technology Hyderabad", role: "Bachelor of Technology (BTech)", detail: "Mathematics & Computing, Minor in Economics" },
]
---

<Layout>
  <MetaPage slot="head" title="About" />
  <about-page>
    <Image class="photo" src={photo} alt="Sai Prateek Katkam" widths={[640, 960, 1400]} sizes="(width >= 64rem) 42rem, 100vw" loading="eager" fetchpriority="high" />
    <prose-content>
      <h1>About</h1>
      <p>Writing about business, tech and everything I find interesting.</p>
    </prose-content>

    <h2>Education</h2>
    <Path items={education} />

    <h2>Past Organisations</h2>
    <Path items={experience} />

    <prose-content>
      <h2>Get in touch</h2>
      <p>Happy to talk business and tech. Reach me at <a href="mailto:saiprateekkatkam@gmail.com">saiprateekkatkam@gmail.com</a> or on <a href="https://www.linkedin.com/in/prateek-katkam/">LinkedIn</a>.</p>
    </prose-content>
  </about-page>
</Layout>

<style>
  about-page { display: block; }
  .photo {
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: 65% 60%;
    border-radius: 0.5rem;
    margin-block-end: var(--space-m);
  }
  h2 {
    font-size: var(--step-0);
    font-weight: var(--font-weight-medium);
    margin-block: var(--space-l) var(--space-s);
  }
</style>
